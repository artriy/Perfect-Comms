<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PerfectComms.Starlight.Media</RootNamespace>
    <AssemblyName>PerfectComms.Starlight.Media</AssemblyName>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultItems>false</EnableDefaultItems>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath>$(MSBuildThisFileDirectory)packages.media.lock.json</NuGetLockFilePath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)..\artifacts\starlight\media\bin\</BaseOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SIPSorcery" Version="10.0.16" />
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="Tmds.LibC" Version="0.2.0" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="*.cs" Exclude="StarlightDependencies*.cs" />
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>PerfectComms.Starlight.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
