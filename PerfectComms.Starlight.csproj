<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>VoiceChatPlugin</RootNamespace>
    <AssemblyName>PerfectComms</AssemblyName>
    <AssemblyTitle>Perfect Comms</AssemblyTitle>
    <Product>Perfect Comms</Product>
    <Company>Perfect Comms</Company>
    <Description>Managed proximity voice for Among Us on Starlight.</Description>
    <Version>4.1.10</Version>
    <AssemblyVersion>4.1.10.0</AssemblyVersion>
    <FileVersion>4.1.10.0</FileVersion>
    <InformationalVersion>4.1.10</InformationalVersion>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);ANDROID;STARLIGHT</DefineConstants>
    <EnableDefaultItems>false</EnableDefaultItems>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>embedded</DebugType>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath>$(MSBuildThisFileDirectory)Starlight\packages.plugin.lock.json</NuGetLockFilePath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)artifacts\starlight\plugin\bin\</BaseOutputPath>
    <StarlightExcludedRoots>PerfectComms.Tests\**;**\tests\**;**\*.Tests\**;native\**;scripts\**;cloudflare\**;TouMira\**;artifacts\**;bin\**;obj\**</StarlightExcludedRoots>
    <StarlightExcludedSources>Comms\SidecarLauncher.cs;Comms\SidecarVoiceClient.cs;Comms\WineEnvironment.cs;Comms\NativeLibraryCache.cs</StarlightExcludedSources>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(StarlightExcludedRoots);$(StarlightExcludedSources)</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.735" Private="false" ExcludeAssets="runtime;native" />
    <PackageReference Include="AmongUs.GameLibs.Android" Version="2026.8.18" PrivateAssets="all" />
    <PackageReference Include="BepInEx.AutoPlugin" Version="1.1.0" PrivateAssets="all" />
    <PackageReference Include="BepInEx.IL2CPP.MSBuild" Version="2.1.0-rc.1" PrivateAssets="all" ExcludeAssets="runtime" />
    <ProjectReference Include="Starlight\PerfectComms.Starlight.Media.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="*.cs;Android\**\*.cs;Api\**\*.cs;Audio\**\*.cs;Comms\**\*.cs;Properties\**\*.cs"
             Exclude="$(StarlightExcludedSources);$(StarlightDependencyManifestPath)" />
    <Compile Include="$(StarlightDependencyManifestPath)"
             Condition="'$(StarlightDependencyManifestPath)' != '' And Exists('$(StarlightDependencyManifestPath)')">
      <Link>StarlightDependencies.g.cs</Link>
    </Compile>
    <Compile Include="Starlight\StarlightDependencies.Empty.cs"
             Condition="'$(StarlightDependencyManifestPath)' == '' Or !Exists('$(StarlightDependencyManifestPath)')" />
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>PerfectComms.Starlight.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>PerfectComms.Starlight.InteropProbe</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\**\*" />
    <EmbeddedResource Include="LICENSE" LogicalName="Licenses.PerfectComms-LICENSE.txt" />
    <EmbeddedResource Include="Starlight\THIRD_PARTY_NOTICES.md" LogicalName="Licenses.THIRD_PARTY_NOTICES.md" />
    <EmbeddedResource Include="Starlight\licenses\SIPSorcery-LICENSE.md" LogicalName="Licenses.SIPSorcery-LICENSE.md" />
  </ItemGroup>
</Project>
