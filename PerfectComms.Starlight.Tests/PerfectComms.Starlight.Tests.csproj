<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);ANDROID;STARLIGHT</DefineConstants>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath>$(MSBuildThisFileDirectory)packages.lock.json</NuGetLockFilePath>
    <AmongUsGameLibsVersion>2026.8.18</AmongUsGameLibsVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AmongUs.GameLibs.Android"
                      Version="$(AmongUsGameLibsVersion)"
                      PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <ProjectReference Include="..\PerfectComms.Starlight.csproj" />
    <ProjectReference Include="..\Starlight\PerfectComms.Starlight.Media.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(NuGetPackageRoot)amongus.gamelibs.android\$(AmongUsGameLibsVersion)\build\Assembly-CSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(NuGetPackageRoot)amongus.gamelibs.android\$(AmongUsGameLibsVersion)\build\UnityEngine.CoreModule.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\PerfectComms.Tests\AndroidMicrophoneMonitorTests.cs"
             Link="AndroidMicrophoneMonitorTests.cs" />
    <Compile Include="..\PerfectComms.Tests\AndroidTouchInputDecisionTests.cs"
             Link="AndroidTouchInputDecisionTests.cs" />
  </ItemGroup>
</Project>
