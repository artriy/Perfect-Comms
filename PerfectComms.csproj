<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<RootNamespace>VoiceChatPlugin</RootNamespace>
		<AssemblyName>PerfectComms</AssemblyName>
		<AssemblyTitle>Perfect Comms</AssemblyTitle>
		<Product>Perfect Comms</Product>
		<Company>Perfect Comms</Company>
		<Description>Native proximity voice for modded Among Us.</Description>
		<Version>4.1.10</Version>
		<!-- 4.1.7 is already immutable on NuGet.org; .1 carries the completed API 1.2 reference contract without changing the mod release version. -->
		<PerfectCommsApiPackageVersion>4.1.7.1</PerfectCommsApiPackageVersion>
		<AssemblyVersion>4.1.10.0</AssemblyVersion>
		<FileVersion>4.1.10.0</FileVersion>
		<InformationalVersion>4.1.10</InformationalVersion>
		<AmongUsGameLibsVersion Condition="'$(AmongUsGameLibsVersion)' == ''">2026.3.31</AmongUsGameLibsVersion>
		<LangVersion>preview</LangVersion>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<DebugType>embedded</DebugType>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);1573;1591</NoWarn>
		<!-- Among Us/BepInEx IL2CPP currently targets net6.0; selected transitive libraries are runtime-compatible here despite newer TFM support warnings. -->
		<SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
		<GenerateAssemblyInfo>True</GenerateAssemblyInfo>
		<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
		<NuGetAudit>true</NuGetAudit>
		<NuGetAuditMode>all</NuGetAuditMode>
		<NuGetAuditLevel>low</NuGetAuditLevel>
		<WarningsAsErrors>$(WarningsAsErrors);NU1900;NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
		<Configurations>Debug;Release;Windows</Configurations>
		<DefaultItemExcludes>$(DefaultItemExcludes);artifacts/**;TouMira/**;PerfectComms.Tests/**;PerfectComms.Starlight.Tests/**;cloudflare/**;packaging/**;scripts/**;native/**;Starlight/**</DefaultItemExcludes>
	</PropertyGroup>

	<!-- Desktop build (default): native sidecar media engine -->
	<PropertyGroup>
		<DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<!-- 735 is the newest pinned runtime compatible with the current official
		     BepInEx.IL2CPP.MSBuild generator. 738+ removed CecilMetadataAccess and
		     makes clean interop generation fail before compilation. -->
		<PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.735" Private="false" ExcludeAssets="runtime;native" />
		<PackageReference Include="AmongUs.GameLibs.Steam" Version="$(AmongUsGameLibsVersion)" PrivateAssets="all" />
		<PackageReference Include="BepInEx.AutoPlugin" Version="1.1.0" PrivateAssets="all" />
		<PackageReference Include="BepInEx.IL2CPP.MSBuild" Version="2.1.0-rc.1" PrivateAssets="all" ExcludeAssets="runtime" />
		<!-- These assemblies are loaded from embedded resources at runtime. Keep them
		     explicit so a clean restore always stages the exact files embedded below. -->
		<PackageReference Include="System.Text.Encodings.Web" Version="10.0.10" PrivateAssets="all" GeneratePathProperty="true" />
		<PackageReference Include="System.Text.Json" Version="10.0.10" PrivateAssets="all" GeneratePathProperty="true" />
		<!-- System.Text.Json's netstandard asset requires these runtime assemblies on
		     the pinned BepInEx host, so keep them embedded with the serializer. -->
		<PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.10" PrivateAssets="all" GeneratePathProperty="true" />
		<PackageReference Include="System.IO.Pipelines" Version="10.0.10" PrivateAssets="all" GeneratePathProperty="true" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\**" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Libs\pc-capture\pc-capture-win-x64.exe" Condition="Exists('Libs\pc-capture\pc-capture-win-x64.exe')">
			<LogicalName>Lib.pc-capture.pc-capture-win-x64.exe</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="Libs\pc-capture\pc-capture-win-x86.exe" Condition="Exists('Libs\pc-capture\pc-capture-win-x86.exe')">
			<LogicalName>Lib.pc-capture.pc-capture-win-x86.exe</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="Libs\pc-capture\pc-capture-linux-x64" Condition="Exists('Libs\pc-capture\pc-capture-linux-x64')">
			<LogicalName>Lib.pc-capture.pc-capture-linux-x64</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="Libs\pc-capture\pc-capture-mac.zip" Condition="Exists('Libs\pc-capture\pc-capture-mac.zip')">
			<LogicalName>Lib.pc-capture.pc-capture-mac.zip</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Libs\dsp\webrtc-apm.x64.dll" Condition="Exists('Libs\dsp\webrtc-apm.x64.dll')">
			<LogicalName>Lib.dsp.webrtc-apm.x64.dll</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="Libs\dsp\webrtc-apm.x86.dll" Condition="Exists('Libs\dsp\webrtc-apm.x86.dll')">
			<LogicalName>Lib.dsp.webrtc-apm.x86.dll</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="Libs\dsp\libwebrtc-apm.so" Condition="Exists('Libs\dsp\libwebrtc-apm.so')">
			<LogicalName>Lib.dsp.libwebrtc-apm.so</LogicalName>
		</EmbeddedResource>
		<!-- The macOS APM library is already sealed inside the deep-signed helper app. Embedding the
		     pre-sign copy separately allowed runtime staging to replace the signed file and invalidate
		     the app bundle, so macOS deliberately has no standalone DSP resource. -->
	</ItemGroup>

	<!-- The standalone DLL carries complete notices for every embedded managed and native dependency. -->
	<ItemGroup>
		<EmbeddedResource Include="THIRD_PARTY_NOTICES.md" LogicalName="Licenses.THIRD_PARTY_NOTICES.md" />
		<EmbeddedResource Include="Libs\libcubeb.LICENSE" LogicalName="Licenses.libcubeb-ISC.txt" />
		<EmbeddedResource Include="Libs\cubeb-rs.LICENSE" LogicalName="Licenses.cubeb-rs-ISC.txt" />
		<EmbeddedResource Include="Libs\cubeb-speex-resampler.LICENSE" LogicalName="Licenses.cubeb-speex-resampler-BSD-3-Clause.txt" />
		<EmbeddedResource Include="Libs\cubeb-coreaudio-rust-dependencies.html" LogicalName="Licenses.cubeb-coreaudio-rust-dependencies.html" />
		<EmbeddedResource Include="Libs\opus.COPYING" LogicalName="Licenses.libopus-BSD-3-Clause.txt" />
		<EmbeddedResource Include="Libs\opusic-c.COPYING" LogicalName="Licenses.opusic-c-BSD-3-Clause.txt" />
		<EmbeddedResource Include="Libs\webrtc-apm.COPYING" LogicalName="Licenses.webrtc-audio-processing-BSD-3-Clause.txt" />
		<EmbeddedResource Include="Libs\webrtc-upstream.LICENSE" LogicalName="Licenses.WebRTC-BSD-3-Clause.txt" />
		<EmbeddedResource Include="Libs\webrtc-ooura.LICENSE" LogicalName="Licenses.WebRTC-ooura-BSD.txt" />
		<EmbeddedResource Include="Libs\webrtc-spl-sqrt-floor.LICENSE" LogicalName="Licenses.WebRTC-spl-sqrt-floor-BSD-3-Clause.txt" />
		<EmbeddedResource Include="Libs\webrtc-fft.LICENSE" LogicalName="Licenses.WebRTC-fft-BSD-3-Clause.txt" />
		<EmbeddedResource Include="Libs\webrtc-pffft.LICENSE" LogicalName="Licenses.WebRTC-pffft-BSD-3-Clause.txt" />
		<EmbeddedResource Include="Libs\webrtc-rnnoise.COPYING" LogicalName="Licenses.WebRTC-rnnoise-BSD-3-Clause.txt" />
		<EmbeddedResource Include="Libs\dotnet-runtime.LICENSE.TXT" LogicalName="Licenses.dotnet-runtime-MIT.txt" />
		<EmbeddedResource Include="Libs\system-text-encodings-web.THIRD-PARTY-NOTICES.TXT" LogicalName="Licenses.System.Text.Encodings.Web-THIRD-PARTY-NOTICES.txt" />
		<EmbeddedResource Include="Libs\system-text-json.THIRD-PARTY-NOTICES.TXT" LogicalName="Licenses.System.Text.Json-THIRD-PARTY-NOTICES.txt" />
		<EmbeddedResource Include="Libs\native-rust-dependencies.html" LogicalName="Licenses.native-rust-dependencies.html" />
		<EmbeddedResource Include="Libs\pion-go-dependencies.txt" LogicalName="Licenses.pion-go-dependencies.txt" />
	</ItemGroup>

	<!-- Pion WebRTC v4 is loaded dynamically by the Rust transport facade. -->
	<ItemGroup>
		<EmbeddedResource Include="Libs\pion\pc-pion.x64.dll" Condition="Exists('Libs\pion\pc-pion.x64.dll')">
			<LogicalName>Lib.pc-pion.pc-pion.x64.dll</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="Libs\pion\pc-pion.x86.dll" Condition="Exists('Libs\pion\pc-pion.x86.dll')">
			<LogicalName>Lib.pc-pion.pc-pion.x86.dll</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="Libs\pion\libpc-pion.linux-x64.so" Condition="Exists('Libs\pion\libpc-pion.linux-x64.so')">
			<LogicalName>Lib.pc-pion.libpc-pion.linux-x64.so</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

	<!-- A normal build validates managed code and may intentionally omit native release
	     payloads. The packaging scripts set ValidateReleaseAssets=true and require the
	     complete platform set so a partial local helper cannot produce a green release. -->
	<Target Name="AssertDesktopReleaseAssets" BeforeTargets="PrepareResources"
		Condition="'$(ValidateReleaseAssets)' == 'true'">
		<Error Condition="!Exists('Libs\pc-capture\pc-capture-win-x64.exe')" Text="Missing release helper: Libs\pc-capture\pc-capture-win-x64.exe" />
		<Error Condition="!Exists('Libs\pc-capture\pc-capture-win-x86.exe')" Text="Missing release helper: Libs\pc-capture\pc-capture-win-x86.exe" />
		<Error Condition="!Exists('Libs\pc-capture\pc-capture-linux-x64')" Text="Missing release helper: Libs\pc-capture\pc-capture-linux-x64" />
		<Error Condition="!Exists('Libs\pc-capture\pc-capture-mac.zip')" Text="Missing release helper: Libs\pc-capture\pc-capture-mac.zip" />
		<Error Condition="!Exists('Libs\dsp\webrtc-apm.x64.dll')" Text="Missing release DSP: Libs\dsp\webrtc-apm.x64.dll" />
		<Error Condition="!Exists('Libs\dsp\webrtc-apm.x86.dll')" Text="Missing release DSP: Libs\dsp\webrtc-apm.x86.dll" />
		<Error Condition="!Exists('Libs\dsp\libwebrtc-apm.so')" Text="Missing release DSP: Libs\dsp\libwebrtc-apm.so" />
		<Error Condition="!Exists('Libs\pion\pc-pion.x64.dll')" Text="Missing release Pion transport: Libs\pion\pc-pion.x64.dll" />
		<Error Condition="!Exists('Libs\pion\pc-pion.x86.dll')" Text="Missing release Pion transport: Libs\pion\pc-pion.x86.dll" />
		<Error Condition="!Exists('Libs\pion\libpc-pion.linux-x64.so')" Text="Missing release Pion transport: Libs\pion\libpc-pion.linux-x64.so" />
	</Target>

	<ItemGroup>
		<EmbeddedResource Include="$(PkgSystem_Text_Encodings_Web)\lib\netstandard2.0\System.Text.Encodings.Web.dll">
			<LogicalName>Lib.System.Text.Encodings.Web.dll</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="$(PkgSystem_Text_Json)\lib\netstandard2.0\System.Text.Json.dll">
			<LogicalName>Lib.System.Text.Json.dll</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="$(PkgMicrosoft_Bcl_AsyncInterfaces)\lib\netstandard2.0\Microsoft.Bcl.AsyncInterfaces.dll">
			<LogicalName>Lib.Microsoft.Bcl.AsyncInterfaces.dll</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="$(PkgSystem_IO_Pipelines)\lib\netstandard2.0\System.IO.Pipelines.dll">
			<LogicalName>Lib.System.IO.Pipelines.dll</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

	<PropertyGroup>
		<AmongUsInstall Condition="'$(AmongUsInstall)' == '' and '$(AmongUs)' != ''">$(AmongUs)</AmongUsInstall>
		<AmongUsInstall Condition="'$(AmongUsInstall)' == '' and '$(TouMiraInstall)' != ''">$(TouMiraInstall)</AmongUsInstall>
	</PropertyGroup>

	<Target Name="CopyToAmongUsInstall" AfterTargets="Build" Condition="'$(AmongUsInstall)' != ''">
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(AmongUsInstall)\BepInEx\plugins\" />
	</Target>

</Project>
